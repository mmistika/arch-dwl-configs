From 19b0e8938328ec90d9dcf0d0a2a482d3abb72eb1 Mon Sep 17 00:00:00 2001
From: mmistika <mistikasoft@gmail.com>
Date: Thu, 14 Aug 2025 20:08:14 +0200
Subject: [PATCH 10/18] feat: numlock always on

---
 dwl.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dwl.c b/dwl.c
index 7a923a1..177c492 100644
--- a/dwl.c
+++ b/dwl.c
@@ -400,6 +400,7 @@ static void zoom(const Arg *arg);
 static const char broken[] = "broken";
 static pid_t child_pid = -1;
 static int locked;
+static uint32_t num_lock = 0;
 static void *exclusive_focus;
 static struct wl_display *dpy;
 static struct wl_event_loop *event_loop;
@@ -1068,6 +1069,8 @@ createkeyboard(struct wlr_keyboard *keyboard)
 	/* Set the keymap to match the group keymap */
 	wlr_keyboard_set_keymap(keyboard, kb_group->wlr_group->keyboard.keymap);
 
+	wlr_keyboard_notify_modifiers(keyboard, 0, 0, num_lock, 0);
+
 	/* Add the new keyboard to the group */
 	wlr_keyboard_group_add_keyboard(kb_group->wlr_group, keyboard);
 
@@ -1091,6 +1094,13 @@ createkeyboardgroup(void)
 		die("failed to compile keymap");
 
 	wlr_keyboard_set_keymap(&group->wlr_group->keyboard, keymap);
+
+	xkb_mod_index_t mod_index = xkb_keymap_mod_get_index(keymap, XKB_MOD_NAME_NUM);
+	if (mod_index != XKB_MOD_INVALID) {
+		num_lock |= (uint32_t)1 << mod_index;
+		wlr_keyboard_notify_modifiers(&group->wlr_group->keyboard, 0, 0, num_lock, 0);
+	}
+
 	xkb_keymap_unref(keymap);
 	xkb_context_unref(context);
 
-- 
