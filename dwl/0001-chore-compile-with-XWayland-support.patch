From: mmistika <mistikasoft@gmail.com>
Date: Thu, 14 Aug 2025 19:01:31 +0200
Subject: [PATCH 01/18] chore: compile with XWayland support

---
 config.mk | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/config.mk b/config.mk
index 1e0b810..22bd47b 100644
--- a/config.mk
+++ b/config.mk
@@ -8,10 +8,7 @@ PREFIX = /usr/local
 MANDIR = $(PREFIX)/share/man
 DATADIR = $(PREFIX)/share
 
-XWAYLAND =
-XLIBS =
-# Uncomment to build XWayland support
-#XWAYLAND = -DXWAYLAND
-#XLIBS = xcb xcb-icccm
+XWAYLAND = -DXWAYLAND
+XLIBS = xcb xcb-icccm
 
 CC = gcc
